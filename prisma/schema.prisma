// Schéma CanCham Connect — traduit depuis lib/types.ts.
//
// Deux principes structurants hérités de la conception :
//   1. `Member` (l'entreprise adhérente, porteuse de la cotisation) et `User`
//      (la personne qui se connecte) sont deux entités distinctes. Une
//      entreprise peut avoir plusieurs utilisateurs.
//   2. Le retard de cotisation n'est PAS stocké : seule la date de bascule
//      (`retardDepuis`) l'est, et le nombre de jours se recalcule à la volée.
//      Aucun job nocturne, aucune désynchronisation possible.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================ Énumérations ============================

/// Statut d'adhésion. Pilote l'accès à toute l'application.
enum MemberStatus {
  candidature // demande déposée, pas encore examinée
  en_attente // approuvée, en attente du paiement
  a_jour // cotisation réglée
  en_retard // cotisation non renouvelée
}

enum MemberType {
  morale // entreprise
  physique // indépendant
}

enum UserRole {
  visiteur
  membre
  admin
}

enum EventFormat {
  presentiel @map("Présentiel")
  webinaire  @map("Webinaire")
  hybride    @map("Hybride")
}

enum AttendeeStatus {
  confirme @map("confirmé")
  present  @map("présent")
  absent
}

enum NewsCategory {
  programmation     @map("Programmation")
  evenement_passe   @map("Événement passé")
  vie_de_la_chambre @map("Vie de la chambre")
  formation         @map("Formation")
}

enum MediaType {
  image
  video
}

enum MediaTheme {
  navy
  green
}

enum ResourceCategory {
  guide     @map("Guide")
  modele    @map("Modèle")
  formation @map("Formation")
  rapport   @map("Rapport")
}

enum ResourceFormat {
  pdf   @map("PDF")
  docx  @map("DOCX")
  video @map("Vidéo")
}

/// Gratuit ou facturé. Partagé par les services de la chambre et les ressources.
enum PricingType {
  gratuit
  payant
}

enum InvoiceStatus {
  payee
  envoyee
}

enum ThreadType {
  individuel
  groupe
}

// ============================ Membres & utilisateurs ============================

/// Formule d'adhésion, telle que la propose la fiche d'inscription de la chambre.
/// Le tarif de chacune vit dans `lib/membership.ts` : la base ne garde que le choix.
enum Formule {
  mg_consultant @map("madagascar_consultant")
  mg_entreprise @map("madagascar_entreprise")
  ca_diaspora   @map("canada_diaspora")
  ca_entreprise @map("canada_entreprise")
  sur_mesure    @map("sur_mesure")
}

/// Devise d'une facture. Les formules canadiennes se règlent en dollars.
enum Devise {
  MGA
  CAD
}

model Member {
  id           String       @id @default(cuid())
  type         MemberType   @default(morale)
  nom          String
  secteur      String
  ville        String
  statut       MemberStatus @default(candidature)
  /// Formule choisie à l'inscription. Elle fixe le montant de la cotisation.
  formule      Formule      @default(mg_entreprise)
  /// Date d'adhésion.
  adhesion     DateTime     @db.Date
  /// Date de bascule en retard. Le nombre de jours s'en déduit.
  retardDepuis DateTime?    @db.Date

  /// Description courte, en tête de fiche.
  activite String
  /// Description détaillée.
  desc     String
  /// Ce que le membre recherche — moteur de la mise en relation.
  besoins  String?
  /// Secteurs et collaborations qui l'intéressent.
  interets String?

  // Renseignés à la candidature, consultés par l'équipe CanCham.
  statutJuridique String?
  pays            String?
  siteweb         String?
  motivation      String?

  /// Trace du dernier règlement enregistré.
  paiementNote String?

  /// Photo de couverture de la fiche, par URL. `null` = dégradé décoratif.
  cover String?
  /// Vignette ronde du membre : portrait pour une personne physique, logo ou
  /// visuel d'activité pour une personne morale. `null` = monogramme.
  photo String?
  /// Logo de l'organisation, par URL. Affiché en `contain` sur fond blanc : il
  /// a des marges propres et de la transparence, un cadrage le mutilerait.
  logo  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  produits     Produit[]
  offres       Offer[]
  factures     Invoice[]
  inscriptions Registration[]

  @@index([statut])
  @@map("members")
}

model User {
  id       String   @id @default(cuid())
  role     UserRole @default(membre)
  nom      String
  fonction String
  email    String   @unique
  tel      String?
  /// Portrait de l'utilisateur, par URL. `null` = initiales.
  photo    String?

  /// Empreinte du mot de passe (scrypt), jamais le mot de passe lui-même.
  /// `null` pour un compte créé par l'équipe qui ne s'est pas encore connecté.
  motDePasse String?

  /// `null` pour l'équipe CanCham et les visiteurs.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Contact principal de l'entreprise — un seul par membre.
  contactPrincipal Boolean @default(false)

  jaimes             NewsLike[]
  participations     ParticipantFil[]
  commentaires       Comment[]
  jaimesCommentaires CommentLike[]
  rappels            Rappel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("users")
}

/// Nature d'une offre du catalogue d'un membre.
enum ProduitType {
  produit
  service
}

model Produit {
  id          String      @id @default(cuid())
  /// Titre de l'offre.
  label       String
  type        ProduitType @default(service)
  /// Ce que l'offre comprend, pour qui, à quelles conditions.
  description String?
  /// Prix indicatif, en clair : « 25 000 Ar le flacon », « Sur devis ».
  /// Un champ libre plutôt qu'un montant : la plupart des services se chiffrent
  /// au cas par cas, et un nombre obligatoire pousserait à inventer.
  prix        String?
  /// Galerie du produit, dans l'ordre d'affichage. La première photo sert de
  /// vignette partout où une seule image tient ; vide = dégradé décoratif.
  photos      String[]    @default([])
  /// Ordre d'affichage sur la fiche membre.
  ordre       Int         @default(0)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("produits")
}

// ============================ Événements ============================

model Event {
  id      String      @id @default(cuid())
  titre   String
  date    DateTime    @db.Date
  lieu    String
  format  EventFormat
  /// Capacité d'accueil.
  cap     Int
  payant  Boolean     @default(false)
  /// En Ariary. 0 si gratuit.
  prix    Int         @default(0)
  desc    String
  photo   String?
  /// Heure de début, « HH:MM ». `null` = toute la journée.
  debut   String?
  /// Heure de fin, « HH:MM ». `null` = pas d'heure de fin annoncée.
  fin     String?
  /// À qui l'événement s'adresse en priorité.
  pourQui String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptions Registration[]
  participants Attendee[]
  programme    EventAgenda[]

  @@index([date])
  @@map("events")
}

/// Inscription d'un membre à un événement.
model Registration {
  id   String @id @default(cuid())
  /// Code présenté à l'accueil.
  code String @unique

  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Un membre ne s'inscrit qu'une fois par événement.
  @@unique([eventId, memberId])
  @@map("registrations")
}

/// Personne présente à un événement, membre ou non.
/// Une étape du déroulé d'un événement.
model EventAgenda {
  id     String  @id @default(cuid())
  /// Heure de l'étape : « 18 h 00 ».
  heure  String
  titre  String
  detail String?
  ordre  Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, ordre])
  @@map("event_agenda")
}

model Attendee {
  id         String         @id @default(cuid())
  nom        String
  entreprise String
  email      String
  statut     AttendeeStatus @default(confirme)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("attendees")
}

// ============================ Agenda ============================

/// Rappel personnel noté dans l'agenda.
///
/// Il appartient à une personne, pas à l'entreprise : deux collaborateurs d'un
/// même membre ne partagent pas leurs pense-bêtes. Les événements et les
/// échéances, eux, ne sont pas stockés ici : ils se lisent là où ils vivent.
model Rappel {
  id    String   @id @default(cuid())
  titre String
  note  String?
  jour  DateTime @db.Date
  /// « HH:MM ». `null` = toute la journée.
  heure String?
  fait  Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, jour])
  @@map("rappels")
}

// ============================ Contenus ============================

model News {
  id      String       @id @default(cuid())
  titre   String
  date    DateTime     @db.Date
  cat     NewsCategory
  extrait String
  corps   String

  mediaType     MediaType
  mediaTheme    MediaTheme
  /// Photos de l'article, dans l'ordre d'affichage : la première sert de
  /// couverture dans le fil. Vide = dégradé décoratif.
  images        String[]   @default([])
  /// Durée de la vidéo, au format mm:ss. `null` pour une photo.
  mediaDuration String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commentaires Comment[]
  jaimes       NewsLike[]

  @@index([date])
  @@map("news")
}

/// Un « j'aime » posé par un utilisateur sur une publication.
///
/// Une ligne par personne, et la contrainte d'unicité en garantit une seule :
/// un compteur incrémenté aurait laissé cliquer dix fois de suite, et n'aurait
/// pas su dire si la personne qui regarde a déjà aimé.
model NewsLike {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([newsId, userId])
  @@index([newsId])
  @@map("news_likes")
}

model Resource {
  id     String           @id @default(cuid())
  titre  String
  cat    ResourceCategory
  fmt    ResourceFormat
  /// Poids du fichier ou durée de la vidéo — c'est une étiquette, pas une mesure.
  taille String
  date   DateTime         @db.Date

  /// Nom du fichier source, rangé dans le stockage privé des ressources —
  /// jamais dans `public/`, sans quoi il suffirait de son URL pour le récupérer.
  /// `null` = ressource sans contenu consultable.
  fichier String?
  /// Nombre de pages rendues en images, pour un document. `null` pour une vidéo.
  pages   Int?
  /// Visuel de la carte dans la bibliothèque. `null` = motif décoratif.
  cover   String?

  /// Inclus dans l'adhésion, ou facturé en supplément.
  type PricingType @default(gratuit)
  /// En Ariary. 0 si gratuit.
  prix Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commentaires Comment[]

  @@index([type])
  @@map("resources")
}

/// Commentaire sur une actualité ou sur une ressource.
model Comment {
  id         String   @id @default(cuid())
  auteur     String
  entreprise String
  texte      String
  date       DateTime @db.Date

  newsId     String?
  news       News?     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// Auteur du commentaire : lui seul peut le modifier ou le supprimer. Le
  /// nom et l'entreprise restent copiés à côté, pour qu'un compte supprimé
  /// ne rende pas le commentaire anonyme.
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Dernière modification par son auteur.
  modifieLe DateTime?

  jaimes CommentLike[]

  createdAt DateTime @default(now())

  @@index([newsId])
  @@index([resourceId])
  @@map("comments")
}

/// Un « j'aime » posé sur un commentaire. Une ligne par personne.
model CommentLike {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_likes")
}

/// Promotion publiée PAR un membre, à destination des autres membres.
model Offer {
  id    String  @id @default(cuid())
  titre String
  desc  String
  /// Visuel de l'offre. `null` = la couverture de l'entreprise qui la propose.
  image String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("offers")
}

/// Service proposé PAR la chambre à ses membres. À ne pas confondre avec Offer.
model CanchamService {
  id    String      @id @default(cuid())
  titre String
  desc  String
  type  PricingType @default(gratuit)
  /// En Ariary. 0 si gratuit.
  prix  Int         @default(0)
  icon  String      @default("award")
  ordre Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cancham_services")
}

// ============================ Facturation ============================

model Invoice {
  id      String        @id @default(cuid())
  numero  String        @unique
  date    DateTime      @db.Date
  objet   String
  /// Montant dans la devise de la facture, en unités entières.
  montant Int
  devise  Devise        @default(MGA)
  statut  InvoiceStatus @default(envoyee)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("invoices")
}

// ============================ Messagerie ============================

/// Un fil de discussion : un échange entre deux personnes, un groupe, ou
/// l'assistance d'un membre par l'équipe CanCham.
///
/// Ce qui s'affiche en tête d'un échange individuel dépend de qui regarde :
/// chacun voit l'autre. Le nom et le visuel ne sont donc stockés que pour un
/// groupe — ou pour l'assistance, que le membre voit sous le nom de la chambre.
model MessageThread {
  id     String     @id @default(cuid())
  type   ThreadType
  /// Nom du groupe, ou « Équipe CanCham ». `null` pour un échange individuel.
  nom    String?
  /// Photo du groupe. `null` = initiales.
  avatar String?
  /// Fil d'assistance : le membre y parle à la chambre, pas à une personne.
  /// Toute l'équipe y participe, et chacun de ses membres y voit le membre.
  equipe Boolean    @default(false)

  createdAt DateTime @default(now())

  messages     Message[]
  participants ParticipantFil[]

  @@map("message_threads")
}

/// Participation d'un utilisateur à un fil. C'est elle qui ouvre l'accès :
/// un fil n'est visible, et ses pièces jointes lisibles, que par ses
/// participants.
model ParticipantFil {
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Dernière ouverture du fil. Les messages postérieurs écrits par les autres
  /// sont non lus ; `null` = jamais ouvert.
  luLe     DateTime?
  ajouteLe DateTime  @default(now())

  @@id([threadId, userId])
  @@index([userId])
  @@map("participants_fils")
}

model Message {
  id     String   @id @default(cuid())
  auteur String
  texte  String
  sentAt DateTime

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Auteur du message, quand il s'agit d'un utilisateur connu.
  userId String?

  /// Dernière modification du texte par son auteur.
  modifieLe  DateTime?
  /// Suppression par son auteur. La ligne reste, vidée de son texte et de ses
  /// pièces : la conversation garde la trace qu'un message a existé à cet
  /// endroit, sans en conserver le contenu.
  supprimeLe DateTime?
  /// Copie d'un message transféré depuis une autre conversation.
  transfere  Boolean   @default(false)

  piecesJointes PieceJointe[]

  @@index([threadId])
  @@map("messages")
}

enum TypePieceJointe {
  image
  video
  pdf
}

/// Fichier joint à un message : image, vidéo ou PDF.
///
/// Rangé dans le stockage privé et servi par une route contrôlée, comme les
/// ressources : une conversation n'a pas à être lisible par qui devine une URL.
model PieceJointe {
  id      String          @id @default(cuid())
  /// Nom d'origine, affiché tel que l'expéditeur l'a envoyé.
  nom     String
  type    TypePieceJointe
  /// Nom du fichier dans le stockage privé.
  fichier String
  /// Poids en octets, pour l'afficher sans relire le fichier.
  taille  Int

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("pieces_jointes")
}

// ============================ Journal ============================

/// Journal des opérations sensibles.
///
/// Une opération financière ne doit jamais disparaître silencieusement : une
/// suppression de membre ou une validation de paiement laisse une trace ici.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  /// Modèle concerné, ex. « Member » ou « Invoice ».
  entite    String
  entiteId  String
  /// Qui a agi.
  acteur    String
  /// Détail libre de l'opération.
  detail    String?
  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@map("audit_logs")
}
