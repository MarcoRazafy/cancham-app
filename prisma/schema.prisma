generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  candidature
  refusee
  en_attente
  a_jour
  en_retard
}

enum MemberType {
  morale
  physique
}

enum UserRole {
  visiteur
  membre
  admin
}

enum NiveauEquipe {
  administrateur
  manager
}

enum EventFormat {
  presentiel @map("Présentiel")
  webinaire  @map("Webinaire")
  hybride    @map("Hybride")
}

enum AttendeeStatus {
  a_valider @map("à valider")
  confirme  @map("confirmé")
  present   @map("présent")
  absent
}

enum NewsCategory {
  programmation     @map("Programmation")
  evenement_passe   @map("Événement passé")
  vie_de_la_chambre @map("Vie de la chambre")
  formation         @map("Formation")
}

enum MediaType {
  image
  video
}

enum MediaTheme {
  navy
  green
}

enum ResourceCategory {
  guide     @map("Guide")
  modele    @map("Modèle")
  formation @map("Formation")
  rapport   @map("Rapport")
}

enum ResourceFormat {
  pdf   @map("PDF")
  docx  @map("DOCX")
  video @map("Vidéo")
  image @map("Photo")
  page  @map("Page")
}

enum PricingType {
  gratuit
  payant
}

enum EmplacementOffre {
  partout
  actualites
  tableau_de_bord
}

enum InvoiceStatus {
  payee
  envoyee
}

enum ThreadType {
  individuel
  groupe
}

enum Formule {
  mg_consultant @map("madagascar_consultant")
  mg_entreprise @map("madagascar_entreprise")
  ca_diaspora   @map("canada_diaspora")
  ca_entreprise @map("canada_entreprise")
  sur_mesure    @map("sur_mesure")
}

enum Devise {
  MGA
  CAD
}

enum PaiementStatut {
  en_cours
  annonce
  reussie
  echouee
  abandonnee
}

enum ModeReglement {
  mvola
  orange_money
  airtel_money
  virement
  depot
  especes
  carte
  plateforme
}

model Member {
  id           String       @id @default(cuid())
  type         MemberType   @default(morale)
  nom          String
  secteur      String
  ville        String
  statut       MemberStatus @default(candidature)
  formule      Formule?
  adhesion     DateTime     @db.Date
  retardDepuis DateTime?    @db.Date

  activite String
  desc     String
  besoins  String?
  interets String?

  statutJuridique String?
  pays            String?
  siteweb         String?
  motivation      String?

  paiementNote String?

  accueilEnCours Boolean @default(false)

  cover  String?
  coverX Int     @default(50)
  coverY Int     @default(50)
  photo  String?
  logo   String?
  video  String?

  // Tags : repères internes de l’équipe sur l’entreprise (cibler une newsletter, suivre un groupe)
  etiquettes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  produits      Produit[]
  offres        Offer[]
  actualites    News[]
  factures      Invoice[]
  inscriptions  Registration[]
  rendezvous    Rendezvous[]
  notes         NoteMembre[]
  acces         AccesRessource[]
  accesDossiers AccesDossier[]
  reglements    Paiement[]

  @@index([statut])
  @@map("members")
}

model User {
  id           String        @id @default(cuid())
  role         UserRole      @default(membre)
  niveauEquipe NiveauEquipe?
  nom          String
  fonction     String
  email        String        @unique
  tel          String?
  photo        String?

  motDePasse String?

  motDePasseModifieLe DateTime?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  contactPrincipal Boolean @default(false)

  jaimes             NewsLike[]
  participations     ParticipantFil[]
  commentaires       Comment[]
  jaimesCommentaires CommentLike[]
  rappels            Rappel[]
  jetons             JetonCompte[]
  notesMembres       NoteMembre[]
  abonnementsPush    AbonnementPush[]

  // Rendez-vous : ce que la personne de l’équipe reçoit (spécialité, salle de visio fixe, ouverte ou non)
  specialite String?
  lienVisio  String?
  recoitRdv  Boolean @default(false)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  rendezvous Rendezvous[]       @relation("rdvPris")
  rdvRecus   Rendezvous[]       @relation("rdvHote")
  typesRdv   TypeRendezvous[]
  lectures   LectureRessource[]

  @@index([memberId])
  @@map("users")
}

model AbonnementPush {
  id       String  @id @default(cuid())
  endpoint String  @unique
  p256dh   String
  auth     String
  appareil String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  vuLe      DateTime @default(now())

  @@index([userId])
  @@map("abonnements_push")
}

enum ProduitType {
  produit
  service
}

model Produit {
  id          String      @id @default(cuid())
  label       String
  type        ProduitType @default(service)
  description String?
  prix        String?
  photos      String[]    @default([])
  ordre       Int         @default(0)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("produits")
}

model Event {
  id         String      @id @default(cuid())
  titre      String
  date       DateTime    @db.Date
  lieu       String
  format     EventFormat
  cap        Int
  payant     Boolean     @default(false)
  prix       Int         @default(0)
  public     Boolean     @default(true)
  prixPublic Int         @default(0)
  desc       String
  photo      String?
  debut      String?
  fin        String?
  pourQui    String?

  // Rappels automatiques aux inscrits (7 jours avant, la veille, 2 heures avant) et leur courriel ;
  // sujet et message vides : le texte par défaut
  rappelJ7      Boolean @default(true)
  rappelJ1      Boolean @default(true)
  rappelH2      Boolean @default(false)
  rappelSujet   String?
  rappelMessage String?

  // Tags posés automatiquement sur les entreprises inscrites (à l’enregistrement et à chaque inscription)
  etiquettes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptions      Registration[]
  rappels           RappelEnvoye[]
  rappelsProgrammes RappelEvenement[]
  participants      Attendee[]
  programme         EventAgenda[]
  intervenants      EventIntervenant[]
  factures          Invoice[]

  @@index([date])
  @@map("events")
}

model Registration {
  id   String @id @default(cuid())
  code String @unique

  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@map("registrations")
}

model EventAgenda {
  id     String  @id @default(cuid())
  heure  String
  titre  String
  detail String?
  ordre  Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, ordre])
  @@map("event_agenda")
}

model Attendee {
  id         String         @id @default(cuid())
  nom        String
  entreprise String
  email      String
  telephone  String?
  statut     AttendeeStatus @default(confirme)
  code       String?        @unique
  presentLe  DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("attendees")
}

model Rappel {
  id    String   @id @default(cuid())
  titre String
  note  String?
  jour  DateTime @db.Date
  heure String?
  fait  Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, jour])
  @@map("rappels")
}

model News {
  id      String       @id @default(cuid())
  titre   String
  date    DateTime     @db.Date
  cat     NewsCategory
  extrait String
  corps   String
  public  Boolean      @default(false)

  mediaType     MediaType
  mediaTheme    MediaTheme
  images        String[]   @default([])
  mediaDuration String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  auteurNom String?
  libre     Boolean @default(false)

  commentaires Comment[]
  jaimes       NewsLike[]

  @@index([date])
  @@index([memberId])
  @@map("news")
}

model NewsLike {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([newsId, userId])
  @@index([newsId])
  @@map("news_likes")
}

model Resource {
  id     String           @id @default(cuid())
  titre  String
  cat    ResourceCategory
  fmt    ResourceFormat
  taille String
  date   DateTime         @db.Date

  fichier     String?
  pages       Int?
  cover       String?
  description String?
  contenu     Json?

  type PricingType @default(gratuit)
  prix Int         @default(0)

  ordre Int @default(0)

  dossierId String?
  dossier   DossierRessource? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commentaires Comment[]
  lectures     LectureRessource[]
  acces        AccesRessource[]

  @@index([type])
  @@index([dossierId])
  @@map("resources")
}

model AccesRessource {
  id String @id @default(cuid())

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  ouvertPar String

  createdAt DateTime @default(now())

  @@unique([resourceId, memberId])
  @@index([memberId])
  @@map("acces_ressources")
}

model LectureRessource {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@map("lectures_ressources")
}

model DossierRessource {
  id          String  @id @default(cuid())
  nom         String
  cover       String?
  auteurNom   String?
  auteurRole  String?
  auteurBio   String?
  auteurPhoto String?
  restreint   Boolean @default(false)

  parentId String?
  parent   DossierRessource?  @relation("Arborescence", fields: [parentId], references: [id], onDelete: Cascade)
  enfants  DossierRessource[] @relation("Arborescence")

  ressources Resource[]
  acces      AccesDossier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("dossiers_ressources")
}

model AccesDossier {
  id String @id @default(cuid())

  dossierId String
  dossier   DossierRessource @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  ouvertPar String

  createdAt DateTime @default(now())

  @@unique([dossierId, memberId])
  @@index([memberId])
  @@map("acces_dossiers")
}

model Comment {
  id         String   @id @default(cuid())
  auteur     String
  entreprise String
  texte      String
  date       DateTime @db.Date

  newsId     String?
  news       News?     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  modifieLe DateTime?

  jaimes CommentLike[]

  createdAt DateTime @default(now())

  @@index([newsId])
  @@index([resourceId])
  @@map("comments")
}

model CommentLike {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_likes")
}

model NoteMembre {
  id    String @id @default(cuid())
  texte String

  auteur String

  memberId String
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([memberId])
  @@map("notes_membres")
}

model Offer {
  id          String           @id @default(cuid())
  titre       String
  desc        String
  image       String?
  lien        String?
  prix        String? // texte libre : « 150 000 Ar », « -15 % », « Gratuit »
  emplacement EmplacementOffre @default(partout)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("offers")
}

model CanchamService {
  id    String      @id @default(cuid())
  titre String
  desc  String
  type  PricingType @default(gratuit)
  prix  Int         @default(0)
  icon  String      @default("award")
  image String?
  lien  String?
  ordre Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cancham_services")
}

model Invoice {
  id      String        @id @default(cuid())
  numero  String        @unique
  date    DateTime      @db.Date
  objet   String
  montant Int
  devise  Devise        @default(MGA)
  statut  InvoiceStatus @default(envoyee)
  payeeLe DateTime?     @db.Date

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  destinataireNom String?
  destinataire    Json?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([eventId])
  @@map("invoices")
}

model Paiement {
  id String @id @default(cuid())

  reference String         @unique
  statut    PaiementStatut @default(en_cours)

  montant Int
  devise  Devise @default(MGA)

  mode ModeReglement

  transaction  String?
  notification Json?
  regleLe      DateTime?

  refBancaire String?
  detail      Json?
  annonceLe   DateTime?
  confirmePar String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([memberId])
  @@index([statut])
  @@map("paiements")
}

model CoordonneesPaiement {
  id String @id @default("uniques")

  titulaire String @default("")
  banque    String @default("")
  agence    String @default("")
  rib       String @default("")
  iban      String @default("")
  bic       String @default("")

  mvola       String @default("")
  orangeMoney String @default("")
  airtelMoney String @default("")

  adresseBureau String @default("")
  horaires      String @default("")

  plateformes String @default("")

  updatedAt DateTime @updatedAt

  @@map("coordonnees_paiement")
}

model MessageThread {
  id     String     @id @default(cuid())
  type   ThreadType
  nom    String?
  avatar String?
  equipe Boolean    @default(false)

  visiteur    Json?
  visiteurCle String? @unique

  createdAt DateTime @default(now())

  messages     Message[]
  participants ParticipantFil[]

  @@map("message_threads")
}

model ParticipantFil {
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  luLe     DateTime?
  ajouteLe DateTime  @default(now())

  @@id([threadId, userId])
  @@index([userId])
  @@map("participants_fils")
}

model Message {
  id     String   @id @default(cuid())
  auteur String
  texte  String
  sentAt DateTime

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String?

  modifieLe  DateTime?
  supprimeLe DateTime?
  transfere  Boolean   @default(false)

  piecesJointes PieceJointe[]

  @@index([threadId])
  @@map("messages")
}

enum TypePieceJointe {
  image
  video
  pdf
}

model PieceJointe {
  id      String          @id @default(cuid())
  nom     String
  type    TypePieceJointe
  fichier String
  taille  Int

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("pieces_jointes")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entite    String
  entiteId  String
  acteur    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@map("audit_logs")
}

model JetonCompte {
  id        String    @id @default(cuid())
  empreinte String    @unique
  usage     String
  expire    DateTime
  utiliseLe DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("jetons_compte")
}

model Abonne {
  id     String @id @default(cuid())
  prenom String
  email  String @unique
  source String @default("vitrine")

  desabonneLe DateTime?

  synchroniseLe DateTime?

  // Adresse refusée par le serveur du destinataire (rebond définitif) : plus aucune lettre ne part
  erreurLe DateTime?
  // Dernière invitation à adhérer envoyée par l’équipe
  inviteLe DateTime?

  createdAt DateTime @default(now())

  @@map("abonnes")
}

model TypeRendezvous {
  id     String  @id @default(cuid())
  titre  String
  detail String?
  duree  Int     @default(30)
  actif  Boolean @default(true)
  ordre  Int     @default(0)

  // La personne de l’équipe qui reçoit (vide : l’équipe CanCham), où (visio, bureau, téléphone),
  // la couleur de repère, le prix affiché, et si chaque réservation attend la confirmation de l’équipe
  hoteId     String?
  hote       User?   @relation(fields: [hoteId], references: [id], onDelete: SetNull)
  lieu       String  @default("bureau")
  couleur    String?
  prix       String?
  aConfirmer Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rendezvous Rendezvous[]
  plages     Disponibilite[]

  @@map("types_rendezvous")
}

model Disponibilite {
  id    String @id @default(cuid())
  jour  Int
  debut String
  fin   String

  typeId String
  type   TypeRendezvous @relation(fields: [typeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([typeId, jour])
  @@map("disponibilites")
}

model Rendezvous {
  id String @id @default(cuid())

  typeId String
  type   TypeRendezvous @relation(fields: [typeId], references: [id])

  userId   String
  user     User    @relation("rdvPris", fields: [userId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  jour  DateTime @db.Date
  debut String
  fin   String

  motif String?

  // Qui reçoit (repris du type à la réservation), où, et l’état : « a_confirmer » ou « confirme »
  hoteId     String?
  hote       User?     @relation("rdvHote", fields: [hoteId], references: [id], onDelete: SetNull)
  lieu       String    @default("bureau")
  lienVisio  String?
  statut     String    @default("confirme")
  confirmeLe DateTime?

  annuleLe  DateTime?
  annulePar String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jour])
  @@index([userId])
  @@map("rendezvous")
}

// Un rappel parti : une adresse ne reçoit chaque rappel d’un événement qu’une fois
model RappelEnvoye {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type     String
  email    String
  envoyeLe DateTime @default(now())

  @@unique([eventId, type, email])
  @@map("rappels_envoyes")
}

// Intervenant d’un événement (un ou plusieurs) : affiché dans l’ordre, avec sa photo
model EventIntervenant {
  id         String  @id @default(cuid())
  nom        String
  fonction   String?
  entreprise String?
  bio        String?
  photo      String?
  ordre      Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, ordre])
  @@map("event_intervenants")
}

// Un rappel automatique aux inscrits d’un événement : ses moments d’envoi, son objet et sa lettre.
// Un événement en a autant que l’équipe en ajoute ; les envois sont notés dans RappelEnvoye (type = id du rappel).
model RappelEvenement {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  titre     String?
  dates     DateTime[] @default([])
  avant     Int        @default(0)
  sujet     String?
  message   String?
  createdAt DateTime   @default(now())

  @@index([eventId])
  @@map("rappels_evenement")
}

// Newsletter : une lettre écrite par l’équipe, envoyée par courriel à une audience choisie
// (contacts des membres selon leur statut et les tags de l’entreprise, abonnés à la lettre)
model Lettre {
  id            String        @id @default(cuid())
  sujet         String
  contenu       String
  audience      Json          @default("{}")
  statut        String        @default("brouillon")
  destinataires Int           @default(0)
  envoyes       Int           @default(0)
  envoyeeLe     DateTime?
  // Envoi programmé : les courriels attendent chez Resend jusqu’à cette date (statut « programmee »)
  programmeeLe  DateTime?
  auteur        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  envois        EnvoiLettre[]

  @@map("lettres")
}

// Un courriel d’une lettre, suivi grâce aux webhooks de Resend (remise, ouverture, clic, rebond)
model EnvoiLettre {
  id        String    @id @default(cuid())
  lettreId  String
  lettre    Lettre    @relation(fields: [lettreId], references: [id], onDelete: Cascade)
  email     String
  resendId  String?   @unique
  livreLe   DateTime?
  ouvertLe  DateTime?
  clicLe    DateTime?
  erreurLe  DateTime?
  createdAt DateTime  @default(now())

  @@index([lettreId])
  @@index([email])
  @@map("envois_lettres")
}

// Un tag de l’équipe, qui existe même sans entreprise ; les entreprises le portent dans « etiquettes »
model Tag {
  id        String   @id @default(cuid())
  nom       String   @unique
  createdAt DateTime @default(now())

  @@map("tags")
}

// Tag automatique : toute entreprise dans cette situation reçoit le tag, et le perd quand elle n’y est plus
model RegleTag {
  id        String       @id @default(cuid())
  statut    MemberStatus
  tag       String
  actif     Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([statut, tag])
  @@map("regles_tags")
}
