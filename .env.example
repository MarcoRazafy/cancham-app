# PostgreSQL — cluster système local (service « postgresql », port 5432).
#
# Création de la base, une fois par poste :
#   sudo -u postgres psql -c "CREATE ROLE cancham LOGIN PASSWORD 'choisis-en-un';"
#   sudo -u postgres createdb -O cancham cancham_connect
#
# Puis : npm run db:deploy && npm run db:seed
DATABASE_URL="postgresql://cancham:MOT_DE_PASSE@127.0.0.1:5432/cancham_connect?schema=public"

# Clé de signature des sessions. Obligatoire en production : sans elle,
# n'importe qui pourrait fabriquer un cookie de connexion valide.
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Dossier où la plateforme écrit les fichiers envoyés : images, ressources,
# pièces jointes. En production, le volume persistant de Railway (par
# exemple /data) — le disque du conteneur est effacé à chaque déploiement.
# Laissé vide en local : un dossier stockage/ à la racine du projet.
STOCKAGE_RACINE=

# Adresse publique de la plateforme, sans barre finale. Elle fait les liens
# des e-mails (réinitialisation, invitation, accès). En production :
# https://app.cancham.mg — une adresse localhost y est ignorée. Laissée vide
# en local : l'hôte de la requête suffit.
APP_URL=

# E-mails, par Resend (resend.com). Sans clé, rien ne part : le message est
# écrit dans les journaux du serveur, lien compris — pratique en local.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend. Par exemple :
# CanCham Connect <connect@cancham.mg>
COURRIEL_EXPEDITEUR=
# Où arrivent les alertes pour l'équipe (nouvelles inscriptions) et les
# réponses aux e-mails automatiques. Vide : l'adresse de contact de la chambre.
COURRIEL_EQUIPE=

SYSTEME_IO_API_KEY=

# Notifications sur l'appareil (Web Push) : ce que le téléphone ou
# l'ordinateur d'un membre reçoit, application fermée ou non. Les deux clés
# VAPID vont ensemble ; sans elles, la cloche ne propose pas « Activer » et
# rien ne part. Générez-les une fois pour toutes :
#   npx web-push generate-vapid-keys
# La clé publique va au navigateur ; la privée signe les envois et ne sort
# jamais du serveur. Changer de clés désabonne tous les appareils.
WEB_PUSH_CLE_PUBLIQUE=
WEB_PUSH_CLE_PRIVEE=

# Paiement en ligne, par Vanilla Pay International : carte bancaire, MVola,
# Orange Money, Airtel Money.
#
# Les quatre sont nécessaires : sans elles, « Payer maintenant » n'apparaît
# pas, la carte reste « Bientôt disponible » et les règlements se constatent
# au back-office.
#
# VANILLAPAY_BASE est l'adresse de leur API, sans barre finale :
#   préproduction (essais, sans argent réel) : https://preprod.vanilla-pay.net
#   production                               : https://api.vanilla-pay.net
# C'est elle qu'on bascule le jour de la mise en service, sans toucher au
# code.
#
# Les trois autres viennent de leur espace marchand : l'identifiant client
# et son secret ouvrent l'API ; la clé secrète (« KeySecret ») signe leurs
# notifications — c'est elle qui prouve qu'un paiement est bien réglé.
# Aucune ne doit sortir du serveur.
#
# Vanilla Pay n'encaisse ici que l'Ariary. Les formules canadiennes se
# règlent par virement.
#
# En attendant les accès, un simulateur local joue le prestataire — même
# parcours, même notification signée, aucun argent réel — quand
# VANILLAPAY_BASE pointe vers nos propres routes (jamais en production) :
#   VANILLAPAY_BASE=http://localhost:3000/api/bac-a-sable/vanillapay
#   VANILLAPAY_CLIENT_ID=bac-a-sable
#   VANILLAPAY_CLIENT_SECRET=une-chaîne-au-hasard
#   VANILLAPAY_KEY_SECRET=une-autre-chaîne-au-hasard
VANILLAPAY_BASE=
VANILLAPAY_CLIENT_ID=
VANILLAPAY_CLIENT_SECRET=
VANILLAPAY_KEY_SECRET=
# Facultative : la version de leur API (en-tête VPI-Version). 2023-01-12 à
# défaut ; à renseigner seulement si leur espace marchand en indique une autre.
VANILLAPAY_VERSION=
# À mettre à 1 quand Vanilla Pay a activé MVola, Orange Money et Airtel Money
# sur le compte marchand : « Payer maintenant » apparaît alors dans ces
# tunnels. Vide : seule la carte passe par eux, et le mobile money se règle
# par envoi depuis le téléphone, que l'équipe confirme.
VANILLAPAY_MOBILE_MONEY=
